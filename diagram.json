{
  "version": 1,
  "author": "STM32 Temperature and Humidity Monitoring Team",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-stm32-bluepill",
      "id": "stm32",
      "top": 110,
      "left": 100,
      "attrs": {}
    },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": 120,
      "left": -110,
      "attrs": {}
    },
    {
      "type": "wokwi-resistor",
      "id": "r_dht",
      "top": 100,
      "left": 20,
      "attrs": { "value": "10000" }
    },
    {
      "type": "board-ssd1306",
      "id": "oled1",
      "top": 280,
      "left": -120,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-led",
      "id": "led_green",
      "top": 20,
      "left": -100,
      "attrs": { "color": "green", "label": "NORMAL" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_green",
      "top": 30,
      "left": -30,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led_red",
      "top": -40,
      "left": -100,
      "attrs": { "color": "red", "label": "ALERT" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_red",
      "top": -30,
      "left": -30,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer1",
      "top": -90,
      "left": 40,
      "attrs": { "volume": "0.5" }
    }
  ],
  "connections": [
    [ "stm32:A9", "$serialMonitor:RX", "green", [] ],
    [ "stm32:A10", "$serialMonitor:TX", "green", [] ],
    [ "dht1:VCC", "stm32:3V3.1", "red", [ "v-15", "h120" ] ],
    [ "dht1:GND", "stm32:GND.1", "black", [ "v20", "h110" ] ],
    [ "dht1:SDA", "stm32:A4", "blue", [ "v0" ] ],
    [ "dht1:SDA", "r_dht:1", "blue", [ "v-10", "h90" ] ],
    [ "r_dht:2", "stm32:3V3.1", "red", [ "v0" ] ],
    [ "stm32:A1", "r_green:2", "green", [ "v-10", "h-50" ] ],
    [ "r_green:1", "led_green:A", "green", [ "v0" ] ],
    [ "led_green:C", "stm32:GND.1", "black", [ "v20", "h120" ] ],
    [ "stm32:A2", "r_red:2", "red", [ "v-20", "h-50" ] ],
    [ "r_red:1", "led_red:A", "red", [ "v0" ] ],
    [ "led_red:C", "stm32:GND.1", "black", [ "v40", "h130" ] ],
    [ "stm32:A3", "buzzer1:1", "purple", [ "v-30", "h-20" ] ],
    [ "buzzer1:2", "stm32:GND.1", "black", [ "v20", "h60" ] ],
    [ "oled1:GND", "stm32:GND.1", "black", [ "v-20", "h130" ] ],
    [ "oled1:VCC", "stm32:3V3.1", "red", [ "v-30", "h140" ] ],
    [ "oled1:SCL", "stm32:B6", "orange", [ "v10", "h180", "v-80" ] ],
    [ "oled1:SDA", "stm32:B7", "cyan", [ "v20", "h190", "v-80" ] ]
  ],
  "serialMonitor": { "convertEol": false, "display": "terminal", "newline": "lf" },
  "dependencies": {}
}
